{
  "id": "bpmn-type-bpmn:EcosTaskAiAgentTask",
  "formKey": "",
  "title": {
    "en": "BPMN AI Agent Task Form",
    "ru": "BPMN форма задачи AI Агента"
  },
  "description": {},
  "customModule": "",
  "typeRef": "",
  "workspace": "",
  "width": "lg",
  "system": true,
  "i18n": {
    "ru": {},
    "en": {}
  },
  "definition": {
    "components": [
      {
        "label": {
          "ru": "ID элемента",
          "en": "Element ID"
        },
        "key": "id",
        "validate": {
          "required": true,
          "pattern": "^[a-zA-Z0-9-_*]+$",
          "minLength": 3
        },
        "defaultValue": "",
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "textfield",
        "input": true
      },
      {
        "label": {
          "ru": "Номер элемента",
          "en": "Element number"
        },
        "key": "number",
        "validate": {
          "integer": false
        },
        "isBigNumber": false,
        "delimiterValue": " ",
        "decimalValue": "",
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "decimalLimit": 0,
        "defaultValue": "",
        "type": "number",
        "input": true
      },
      {
        "label": {
          "ru": "Имя",
          "en": "Name"
        },
        "key": "name_ml",
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "mlText",
        "input": true
      },
      {
        "label": {
          "ru": "Документация",
          "en": "Documentation"
        },
        "key": "documentation",
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "mlTextarea",
        "input": true
      },
      {
        "label": {
          "ru": "Panel"
        },
        "key": "panel_agent",
        "title": {
          "ru": "AI Агент",
          "en": "AI Agent"
        },
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "panel",
        "input": false,
        "components": [
          {
            "label": {
              "ru": "AI Агент",
              "en": "AI Agent"
            },
            "key": "aiAgentRef",
            "tooltip": {
              "ru": "Выберите AI агента из журнала AI Агенты. Агент определяет модель, инструкцию и доступные инструменты.",
              "en": "Select an AI agent from the AI Agents journal. The agent defines the model, instruction, and available tools."
            },
            "validate": {
              "required": true
            },
            "defaultValue": "",
            "refreshOn": [],
            "optionalWhenDisabled": false,
            "type": "selectJournal",
            "input": true,
            "journalId": "ai-agents-journal",
            "queryData": {},
            "isCompact": true,
            "reorder": false
          }
        ]
      },
      {
        "label": {
          "ru": "Panel"
        },
        "key": "panel_preprocessing",
        "title": {
          "ru": "Предобработка",
          "en": "Preprocessing"
        },
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "panel",
        "input": false,
        "components": [
          {
            "label": {
              "ru": "Скрипт",
              "en": "Script"
            },
            "key": "aiPreprocessingScript",
            "tooltip": {
              "ru": "JavaScript, выполняемый до запроса к AI.\nИспользуется для подготовки данных или включения дополнительных документов в контекст.\n\nДля добавления в контекст:\nlet contracts = [\"emodel/ecos-contract@contract1\", \"emodel/ecos-contract@contract2\"];\nexecution.setVariable(\"aiRecordsContext\", DataValue.of(contracts));\n\naiRecordsContext — массив ссылок на документы, доступных AI. Должен быть обернут в DataValue.",
              "en": "JavaScript executed before the AI request.\nUsed to prepare data or include additional documents in the context.\n\nTo add to the context:\nlet contracts = [\"emodel/ecos-contract@contract1\", \"emodel/ecos-contract@contract2\"];\nexecution.setVariable(\"aiRecordsContext\", DataValue.of(contracts));\n\naiRecordsContext is an array of document references available to AI. Should be wrapped in DataValue."
            },
            "editor": "monaco",
            "codeAs": "javascript",
            "defaultValue": "",
            "refreshOn": [],
            "optionalWhenDisabled": false,
            "aiEnabled": true,
            "rows": 15,
            "as": "string",
            "scriptContextType": "bpmn_script_task",
            "type": "textarea",
            "input": true,
            "uploadStorage": "",
            "uploadUrl": "",
            "uploadOptions": "",
            "uploadDir": "",
            "reorder": false,
            "textAreaAIContextType": ""
          }
        ],
        "collapsed": false,
        "reorder": false
      },
      {
        "label": {
          "ru": "Panel"
        },
        "key": "panel_ai_request",
        "title": {
          "ru": "Запрос к AI",
          "en": "AI Request"
        },
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "panel",
        "input": false,
        "components": [
          {
            "label": {
              "ru": "Включить документ в контекст",
              "en": "Include document in context"
            },
            "key": "aiAddDocumentToContext",
            "tooltip": {
              "ru": "Добавляет текущий документ бизнес-процесса в контекст AI-запроса.\nAI сможет учитывать его данные при формировании ответа.",
              "en": "Adds the current business process document to the context of the AI request.\nAI will be able to consider its data when generating a response."
            },
            "validate": {
              "required": true
            },
            "defaultValue": true,
            "refreshOn": [],
            "optionalWhenDisabled": false,
            "type": "checkbox",
            "input": true,
            "reorder": false,
            "dataGridLabel": false
          },
          {
            "label": {
              "ru": "Текст запроса",
              "en": "Request text"
            },
            "key": "aiUserInput",
            "tooltip": {
              "ru": "Промпт, отправляемый AI агенту.\nМожно вставлять переменные процесса через ${someVariable}.\n\nПример:\n\nПодготовь черновик письма клиенту по поводу просроченного платежа. Контактное лицо: ${clientName}, сумма долга: ${debtAmount}, срок просрочки: ${daysOverdue} дней.",
              "en": "Prompt sent to the AI agent.\nYou can insert process variables via ${someVariable}.\n\nExample:\n\nPrepare a draft letter to a customer about a late payment. Contact person: ${clientName}, amount owed: ${debtAmount}, overdue period: ${daysOverdue} days."
            },
            "validate": {
              "required": true
            },
            "defaultValue": "",
            "refreshOn": [],
            "optionalWhenDisabled": false,
            "rows": 7,
            "type": "textarea",
            "input": true,
            "uploadStorage": "",
            "uploadUrl": "",
            "uploadOptions": "",
            "uploadDir": "",
            "as": "",
            "reorder": false
          }
        ]
      },
      {
        "label": {
          "ru": "Panel"
        },
        "key": "panel_postprocessing",
        "title": {
          "ru": "Постобработка",
          "en": "Postprocessing"
        },
        "refreshOn": [],
        "optionalWhenDisabled": false,
        "type": "panel",
        "input": false,
        "collapsed": false,
        "reorder": false,
        "components": [
          {
            "label": {
              "ru": "Сохранить результат в атрибут документа",
              "en": "Save the result to a document attribute"
            },
            "key": "aiSaveResultToDocument",
            "tooltip": {
              "ru": "AI-ответ будет записан в указанный атрибут документа, по которому идет бизнес процесс.",
              "en": "The AI response will be written to the specified attribute of the business process document."
            },
            "validate": {
              "pattern": "^[\\w$/_:-]+\\w$"
            },
            "defaultValue": "",
            "refreshOn": [],
            "optionalWhenDisabled": false,
            "type": "textfield",
            "input": true,
            "inputMasks": [
              {}
            ],
            "reorder": false,
            "dataSrc": ""
          },
          {
            "label": {
              "ru": "Скрипт",
              "en": "Script"
            },
            "key": "aiPostprocessingScript",
            "tooltip": {
              "ru": "JavaScript, выполняемый после получения ответа от AI.\nРезультат запроса доступен в переменной aiResponse.",
              "en": "JavaScript executed after receiving a response from AI.\nThe result of the request is available in the aiResponse variable."
            },
            "editor": "monaco",
            "codeAs": "javascript",
            "defaultValue": "",
            "refreshOn": [],
            "optionalWhenDisabled": false,
            "aiEnabled": true,
            "rows": 15,
            "type": "textarea",
            "input": true,
            "as": "",
            "scriptContextType": "bpmn_script_task",
            "uploadStorage": "",
            "uploadUrl": "",
            "uploadOptions": "",
            "uploadDir": "",
            "reorder": false,
            "textAreaAIContextType": ""
          }
        ]
      },
      {
        "formRef": "uiserv/form@bpmn-base-form-async",
        "input": true,
        "key": "includeForm2",
        "label": "Форма: BPMN base form Async",
        "type": "includeForm"
      }
    ],
    "formId": "bpmn-type-bpmn:EcosTaskAiAgentTask"
  },
  "attributes": {},
  "notExists": false
}
